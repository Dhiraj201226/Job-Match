# ==========================================
# JobMatch AI - Environment Configuration
# DEV Hacktoberfest Week 2 "Side Hustle"
# Powered by Google Gemma 4 (31B Cloud & Local)
# ==========================================

# Mode Switch: "cloud" or "local"
# (If unset, auto-defaults to "cloud" when OLLAMA_API_KEY is present, otherwise "local")
LLM_MODE=cloud

# ----------------------------------------------------
# 1. CLOUD MODE (Ollama Cloud API - Gemma 4 31B)
# ----------------------------------------------------
# Get your API key at: https://ollama.com/settings/keys
OLLAMA_API_KEY=your_ollama_api_key_here

# Gemma 4 Cloud model tag on ollama.com
OLLAMA_MODEL=gemma4:31b-cloud

# Ollama Cloud API endpoint
OLLAMA_CLOUD_URL=https://ollama.com/api/chat

# ----------------------------------------------------
# 2. LOCAL MODE (Zero-Data-Leak Private Laptop Mode)
# ----------------------------------------------------
# Local Ollama server (start with: ollama run gemma4)
OLLAMA_LOCAL_URL=http://localhost:11434

# Lightweight local Gemma 4 model
OLLAMA_LOCAL_MODEL=gemma4:latest
